# Copy this file to server_config.env, then edit it for the PC running the app.
# Do not commit server_config.env. It contains server-only credentials.

COPY_DEST=\\192.168.0.26\Public\CADASTRAL LOT MAP

# MySQL is used for login only. Map/search data is embedded in GeoJSON.
# The app creates DB_DATABASE and gis_users automatically if they do not exist.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cadastral_auth
DB_USERNAME=root
DB_PASSWORD=

APP_HOST=127.0.0.1
APP_PORT=3005
PUBLIC_URL=http://127.0.0.1:3005
NEXT_ALLOWED_DEV_ORIGINS=localhost,127.0.0.1

# Generate a value with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=change-this-to-a-random-32-plus-character-secret

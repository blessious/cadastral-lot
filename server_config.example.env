# Copy this file to server_config.env, then edit it for the PC running the app.
# Do not commit server_config.env. It contains server-only credentials.

COPY_DEST=\\192.168.0.26\Public\CADASTRAL LOT MAP

# MySQL stores authentication and the server-side cadastral search index.
# Deployment migrations create/upgrade the required tables without deleting gis_users.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cadastral_auth
DB_USERNAME=root
DB_PASSWORD=

APP_HOST=127.0.0.1
APP_PORT=3005
APP_CANDIDATE_PORT=3006
PUBLIC_URL=https://cadmap.41itservices.pro
NEXT_ALLOWED_DEV_ORIGINS=localhost,127.0.0.1

# Windows production deployment. The task is registered once by
# install_server_task.bat and starts the active release after a reboot.
SCHEDULED_TASK_NAME=GeoLGU-CadMap
DEPLOY_BRANCH=main
DEPLOY_RELEASES_TO_KEEP=2
DEPLOY_HEALTH_TIMEOUT_SECONDS=60
DEPLOY_VERIFY_PUBLIC=true
DEPLOY_RUN_RESPONSIVE_TESTS=true
DEPLOY_BROWSER_CHANNEL=msedge
DEPLOY_LOG_MAX_MB=10
DEPLOY_LOG_FILES_TO_KEEP=5

# Generate a value with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=change-this-to-a-random-32-plus-character-secret

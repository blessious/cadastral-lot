BOAC_GIS_USERNAME=replace-this
BOAC_GIS_PASSWORD=replace-this-with-a-long-random-password
HOST=0.0.0.0
PORT=3000

# For HTTPS via a Windows-exported PFX:
SSL_PFX_FILE=certificates/boac-gis-local.pfx
SSL_PFX_PASSPHRASE=changeit

# Alternative PEM mode:
# SSL_KEY_FILE=certificates/server-key.pem
# SSL_CERT_FILE=certificates/server-cert.pem
# SSL_CA_FILE=certificates/ca.pem

# Optional hostname to include when generating a local self-signed cert.
# PUBLIC_HOSTNAME=gis.example.com
